<!DOCTYPE html>
<html lang="ar" dir="rtl">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>متجر السكرابات الطبية</title>
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0/css/all.min.css">
    <style>
        /* التصميم العام */
        * {
            margin: 0;
            padding: 0;
            box-sizing: border-box;
            font-family: 'Arial', sans-serif;
        }

        body {
            background: linear-gradient(135deg, #f5f7fa 0%, #c3cfe2 100%);
        }

        /* القائمة المنسدلة */
        .dropdown {
            position: fixed;
            top: 20px;
            left: 20px;
            z-index: 1000;
        }

        .dropdown-btn {
            background: rgba(255, 255, 255, 0.9);
            padding: 15px 25px;
            border-radius: 30px;
            cursor: pointer;
            box-shadow: 0 4px 15px rgba(0, 0, 0, 0.1);
            transition: 0.3s;
        }

        .dropdown-content {
            display: none;
            background: rgba(255, 255, 255, 0.95);
            border-radius: 15px;
            margin-top: 10px;
            min-width: 200px;
            box-shadow: 0 8px 30px rgba(0, 0, 0, 0.1);
        }

        .dropdown-content a {
            display: block;
            padding: 12px 20px;
            text-decoration: none;
            color: #2c3e50;
            transition: 0.3s;
        }

        .dropdown-content a:hover {
            background: #3498db;
            color: white;
            border-radius: 10px;
        }

        /* سلايدر الصور */
        .slider-container {
            height: 100vh;
            overflow: hidden;
            position: relative;
        }

        .slide {
            position: absolute;
            width: 100%;
            height: 100%;
            opacity: 0;
            transition: 1s ease-in-out;
        }

        .slide.active {
            opacity: 1;
        }

        .slide img {
            width: 100%;
            height: 100%;
            object-fit: cover;
        }

        /* قسم المنتجات */
        .products-section {
            display: none;
            padding: 50px 20px;
            background: rgba(255, 255, 255, 0.95);
        }

        .products-grid {
            display: grid;
            grid-template-columns: repeat(auto-fit, minmax(250px, 1fr));
            gap: 30px;
            max-width: 1200px;
            margin: 0 auto;
        }

        .product-card {
            background: white;
            border-radius: 15px;
            overflow: hidden;
            box-shadow: 0 5px 15px rgba(0, 0, 0, 0.1);
            transition: 0.3s;
        }

        .product-card:hover {
            transform: translateY(-10px);
        }

        .product-card img {
            width: 100%;
            height: 200px;
            object-fit: cover;
        }

        .product-info {
            padding: 20px;
            text-align: center;
        }

        /* السلة */
        .cart-section {
            display: none;
            position: fixed;
            top: 20px;
            right: 20px;
            background: rgba(255, 255, 255, 0.95);
            padding: 20px;
            border-radius: 15px;
            width: 300px;
            box-shadow: 0 5px 25px rgba(0, 0, 0, 0.1);
        }
    </style>
</head>
<body>
    <!-- القائمة المنسدلة -->
    <div class="dropdown">
        <div class="dropdown-btn" onclick="toggleDropdown()">
            <i class="fas fa-bars"></i> القائمة
        </div>
        <div class="dropdown-content" id="dropdownContent">
            <a href="#" onclick="showSection('home')">الرئيسية</a>
            <a href="#" onclick="showSection('male')">ملابس الذكور</a>
            <a href="#" onclick="showSection('female')">ملابس الإناث</a>
            <a href="#" onclick="showCart()">السلة</a>
        </div>
    </div>

    <!-- السلايدر الرئيسي -->
    <div class="slider-container" id="home">
        <div class="slide active">
            <img src="https://source.unsplash.com/random/1920x1080?scrubs1" alt="Scrubs 1">
        </div>
        <div class="slide">
            <img src="https://source.unsplash.com/random/1920x1080?scrubs2" alt="Scrubs 2">
        </div>
        <div class="slide">
            <img src="https://source.unsplash.com/random/1920x1080?scrubs3" alt="Scrubs 3">
        </div>
    </div>

    <!-- قسم منتجات الذكور -->
    <div class="products-section" id="male">
        <div class="products-grid"></div>
    </div>

    <!-- قسم منتجات الإناث -->
    <div class="products-section" id="female">
        <div class="products-grid"></div>
    </div>

    <!-- قسم السلة -->
    <div class="cart-section" id="cart">
        <h2>سلة التسوق</h2>
        <div class="cart-items"></div>
        <p class="total-price">المجموع: $0</p>
    </div>

    <script>
        // بيانات المنتجات
        const products = {
            male: [
                {id: 1, name: "سكراب رجالي أزرق", price: 45, image: "https://source.unsplash.com/random/400x600?male-scrubs1"},
                {id: 2, name: "سكراب رجالي أخضر", price: 50, image: "https://source.unsplash.com/random/400x600?male-scrubs2"}
            ],
            female: [
                {id: 3, name: "سكراب نسائي وردي", price: 55, image: "https://source.unsplash.com/random/400x600?female-scrubs1"},
                {id: 4, name: "سكراب نسائي بنفسجي", price: 60, image: "https://source.unsplash.com/random/400x600?female-scrubs2"}
            ]
        };

        // الدوال الأساسية
        let currentSlide = 0;
        const slides = document.querySelectorAll('.slide');

        function nextSlide() {
            slides[currentSlide].classList.remove('active');
            currentSlide = (currentSlide + 1) % slides.length;
            slides[currentSlide].classList.add('active');
        }

        setInterval(nextSlide, 3000);

        function toggleDropdown() {
            document.getElementById("dropdownContent").classList.toggle("show");
        }

        function showSection(sectionId) {
            document.querySelectorAll('.products-section').forEach(section => {
                section.style.display = 'none';
            });
            document.getElementById(sectionId).style.display = 'block';
            document.querySelector('.slider-container').style.display = 'none';
            loadProducts(sectionId);
        }

        function loadProducts(gender) {
            const grid = document.querySelector(`#${gender} .products-grid`);
            grid.innerHTML = '';
            products[gender].forEach(product => {
                grid.innerHTML += `
                    <div class="product-card">
                        <img src="${product.image}" alt="${product.name}">
                        <div class="product-info">
                            <h3>${product.name}</h3>
                            <p>السعر: $${product.price}</p>
                            <button onclick="addToCart(${product.id})">إضافة إلى السلة</button>
                        </div>
                    </div>
                `;
            });
        }

        // دالة السلة
        let cart = [];
        
        function addToCart(productId) {
            const product = [...products.male, ...products.female].find(p => p.id === productId);
            cart.push(product);
            updateCart();
        }

        function updateCart() {
            const cartItems = document.querySelector('.cart-items');
            const totalPrice = document.querySelector('.total-price');
            cartItems.innerHTML = '';
            let total = 0;
            cart.forEach(item => {
                total += item.price;
                cartItems.innerHTML += `
                    <div class="cart-item">
                        <p>${item.name} - $${item.price}</p>
                    </div>
                `;
            });
            totalPrice.textContent = `المجموع: $${total}`;
        }

        function showCart() {
            document.getElementById('cart').style.display = 'block';
        }
    </script>
</body>
</html>
